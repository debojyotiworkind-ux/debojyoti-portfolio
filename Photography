<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Photography — Debojyoti Barat</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Inter:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#080807;--bg2:#0F0F0E;--bg3:#161615;--border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.10);--text:#F2EFE8;--text2:#C8C4BB;--muted:#7A7770;--muted2:#52504C;--gold:#C8930A;--gold2:#E5AB1A;--gold-dim:rgba(200,147,10,0.10);--gold-line:rgba(200,147,10,0.22);--f-serif:"Cormorant Garamond",Georgia,serif;--f-sans:"Inter",system-ui,sans-serif;--f-mono:"JetBrains Mono",monospace}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--f-sans);background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:3px}::-webkit-scrollbar-track{background:var(--bg)}::-webkit-scrollbar-thumb{background:var(--muted2)}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:200;height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 3rem;background:rgba(8,8,7,0.95);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
.nav-logo{font-family:var(--f-serif);font-size:1.4rem;font-weight:500;color:var(--text);text-decoration:none;letter-spacing:.02em}
.nav-logo span{color:var(--gold);font-style:italic}
.nav-center{display:flex;align-items:center}
.nav-link{font-family:var(--f-mono);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;color:var(--muted);padding:0 1.1rem;height:62px;display:flex;align-items:center;border-right:1px solid var(--border);transition:color .2s,background .2s;position:relative;white-space:nowrap}
.nav-link:first-child{border-left:1px solid var(--border)}
.nav-link:hover{color:var(--text);background:var(--bg2)}
.nav-link.active{color:var(--gold)}
.nav-link.active::after{content:"";position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--gold)}

/* DROPDOWN */
.nav-dropdown{position:relative}
.nav-dropdown-btn{font-family:var(--f-mono);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:0 1.1rem;height:62px;display:flex;align-items:center;gap:.4rem;border-right:1px solid var(--border);border-left:1px solid var(--border);cursor:pointer;background:none;border-top:none;border-bottom:none;transition:color .2s,background .2s;position:relative}
.nav-dropdown-btn:hover,.nav-dropdown:hover .nav-dropdown-btn{color:var(--text);background:var(--bg2)}
.nav-dropdown-btn.active{color:var(--gold)}
.nav-dropdown-btn.active::after{content:"";position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--gold)}
.nav-dropdown-btn svg{width:10px;height:10px;transition:transform .2s}
.nav-dropdown:hover .nav-dropdown-btn svg{transform:rotate(180deg)}
.dropdown-menu{position:absolute;top:62px;left:0;min-width:220px;background:var(--bg2);border:1px solid var(--border2);border-top:none;display:none;flex-direction:column;z-index:300}
.nav-dropdown:hover .dropdown-menu{display:flex}
.dropdown-item{font-family:var(--f-mono);font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;color:var(--muted);padding:.9rem 1.25rem;border-bottom:1px solid var(--border);transition:color .2s,background .2s;display:flex;align-items:center;gap:.6rem}
.dropdown-item:last-child{border-bottom:none}
.dropdown-item:hover{color:var(--gold);background:var(--bg3)}
.dropdown-item.active{color:var(--gold)}
.dropdown-item::before{content:"";width:4px;height:4px;background:currentColor;border-radius:50%;flex-shrink:0}

.nav-hire{font-family:var(--f-mono);font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:var(--bg);background:var(--gold);padding:.5rem 1.25rem;border-radius:2px;transition:background .2s;white-space:nowrap}
.nav-hire:hover{background:var(--gold2)}

/* PAGE HERO */
.page-hero{padding:8rem 3rem 5rem;border-bottom:1px solid var(--border);position:relative;overflow:hidden}
.hero-bg{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(ellipse 70% 100% at 30% 0%,black 30%,transparent 100%)}
.hero-glow{position:absolute;top:30%;left:20%;width:600px;height:400px;background:radial-gradient(ellipse,rgba(200,147,10,0.04) 0%,transparent 70%);pointer-events:none}
.hero-inner{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:end}
.ph-tag{font-family:var(--f-mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:1.25rem;display:flex;align-items:center;gap:.75rem}
.ph-tag::before{content:"";width:20px;height:1px;background:var(--gold)}
.ph-h{font-family:var(--f-serif);font-size:clamp(3rem,7vw,7rem);font-weight:300;line-height:.92;letter-spacing:-.02em;color:var(--text);margin-bottom:1.5rem}
.ph-h em{font-style:italic;color:var(--gold)}
.ph-sub{font-size:.92rem;color:var(--muted);line-height:1.8;max-width:440px}
.hero-right{text-align:right}
.hero-quote{font-family:var(--f-serif);font-size:1.4rem;font-weight:300;font-style:italic;color:var(--muted);line-height:1.5;max-width:380px;margin-left:auto}
.hero-quote em{color:var(--gold);font-style:normal}

/* SERIES GRID */
.series-section{padding:5rem 3rem}
.series-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);margin-top:3.5rem}
.series-card{background:var(--bg2);overflow:hidden;text-decoration:none;display:flex;flex-direction:column;transition:background .2s;position:relative}
.series-card:hover{background:var(--bg3)}
.series-card:hover .sc-img{transform:scale(1.04);filter:brightness(.85)}
.series-card:hover .sc-arrow{background:var(--gold);border-color:var(--gold);color:var(--bg)}
.sc-thumb{position:relative;overflow:hidden;aspect-ratio:3/4}
.sc-img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.6) saturate(.7);transition:filter .5s,transform .6s}
.sc-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(8,8,7,0.9) 0%,rgba(8,8,7,0.2) 50%,transparent 100%)}
.sc-count{position:absolute;top:1.5rem;right:1.5rem;font-family:var(--f-mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,0.4);background:rgba(8,8,7,0.6);padding:.3rem .6rem;border-radius:2px;backdrop-filter:blur(4px)}
.sc-body{padding:2rem}
.sc-cat{font-family:var(--f-mono);font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);margin-bottom:.6rem}
.sc-title{font-family:var(--f-serif);font-size:1.6rem;font-weight:300;color:var(--text);line-height:1.1;margin-bottom:.6rem}
.sc-title em{font-style:italic;color:var(--gold)}
.sc-desc{font-size:.78rem;color:var(--muted);line-height:1.7;margin-bottom:1.5rem}
.sc-foot{display:flex;justify-content:space-between;align-items:center;padding-top:1rem;border-top:1px solid var(--border)}
.sc-tag{font-family:var(--f-mono);font-size:.55rem;letter-spacing:.06em;text-transform:uppercase;color:var(--muted2)}
.sc-arrow{width:32px;height:32px;border:1px solid var(--border2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.8rem;color:var(--muted2);transition:all .2s}

/* PHILOSOPHY */
.philosophy{padding:5rem 3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--bg2);display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}
.phil-left .sec-tag{font-family:var(--f-mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem;display:flex;align-items:center;gap:.75rem}
.phil-left .sec-tag::before{content:"";width:20px;height:1px;background:var(--gold)}
.phil-left h2{font-family:var(--f-serif);font-size:clamp(2rem,3.5vw,3rem);font-weight:300;color:var(--text);line-height:1.05;margin-bottom:1.5rem}
.phil-left h2 em{font-style:italic;color:var(--gold)}
.phil-left p{font-size:.9rem;color:var(--muted);line-height:1.85}
.phil-right{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border)}
.phil-stat{background:var(--bg2);padding:2rem 1.5rem}
.phil-stat-n{font-family:var(--f-serif);font-size:2.8rem;font-weight:300;color:var(--gold);line-height:1}
.phil-stat-l{font-family:var(--f-mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:.35rem}

/* FOOTER */
footer{border-top:1px solid var(--border);padding:2rem 3rem;display:flex;justify-content:space-between;align-items:center;background:var(--bg2)}
.footer-l{font-family:var(--f-serif);font-size:1rem;color:var(--muted)}
.footer-l em{font-style:italic;color:var(--gold)}
.footer-links{display:flex;gap:1.5rem}
.footer-links a{font-family:var(--f-mono);font-size:.58rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted2);text-decoration:none;transition:color .2s}
.footer-links a:hover{color:var(--gold)}
.footer-r{font-family:var(--f-mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted2)}

@media(max-width:900px){nav{padding:0 1.25rem}.nav-center{display:none}.page-hero{padding:6rem 1.5rem 3rem}.hero-inner{grid-template-columns:1fr}.hero-right{display:none}.series-grid{grid-template-columns:1fr}.philosophy{grid-template-columns:1fr;padding:3rem 1.5rem;gap:2.5rem}.series-section{padding:3rem 1.5rem}footer{flex-direction:column;gap:1rem;text-align:center}}
</style>
</head>
